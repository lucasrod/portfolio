---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
---

<BaseLayout title="Contact" description="How to contact Lucas Rodriguez about junior roles in data science, analytics and machine learning.">
  <div class="wrap pt-10 md:pt-16">
    <h1 class="font-serif text-[2.6rem] leading-[1.05] font-[400] tracking-[-0.015em] [font-variation-settings:'opsz'_72] md:text-5xl">Contact</h1>
    <p class="mt-5 max-w-[52ch] font-serif text-lg leading-snug text-ink-2">
      I'm looking for junior roles and internships in data science, analytics and machine learning. I'm happy to walk through
      any project here, including what is still unfinished.
    </p>
    <ContactLinks class="mt-8" />
  </div>
</BaseLayout>
