---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <div class="wrap pt-16 md:pt-24">
    <h1 class="font-serif text-[2.6rem] leading-[1.05] font-[400] [font-variation-settings:'opsz'_72] md:text-5xl">This page doesn't exist</h1>
    <p class="mt-5 max-w-[48ch] font-serif text-lg leading-snug text-ink-2">
      The address may have changed. The projects are all listed on one page.
    </p>
    <p class="mt-8"><a href="/projects/" class="btn btn-primary">Go to projects</a></p>
  </div>
</BaseLayout>
