---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { caseUrl, t, type Lang } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  headings: MarkdownHeading[];
  translation?: CollectionEntry<'projects'>;
}
const { project, headings, translation } = Astro.props;
const d = project.data;
const lang = d.lang as Lang;
const sections = headings.filter((h) => h.depth === 2);
const date = new Intl.DateTimeFormat(lang === 'es' ? 'es-UY' : 'en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(d.verified.date);
const commitUrl = d.repo.url && d.repo.visibility === 'public' ? `${d.repo.url}/tree/${d.verified.commit}` : undefined;
const alternate = translation ? { lang: translation.data.lang as Lang, href: caseUrl(translation.id, translation.data.lang) } : undefined;
---

<BaseLayout title={d.title} description={d.summary} lang={lang} alternate={alternate}>
  <article class="wrap pt-10 md:pt-16">
    <header class="max-w-[52rem]">
      <p class="font-sans text-sm text-ink-2">
        <a href="/projects/" class="link">{t(lang, 'nav.projects')}</a>
      </p>
      <h1 class="mt-5 font-serif text-[2.6rem] leading-[1.05] font-[400] tracking-[-0.015em] [font-variation-settings:'opsz'_72] md:text-5xl">
        {d.title}
      </h1>
      <p class="mt-5 max-w-[46ch] font-serif text-lg leading-snug text-ink-2 md:text-xl">{d.question}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <StatusBadge status={d.status} lang={lang} />
        {lang !== 'en' && t(lang, 'case.lang-note') && <span class="font-sans text-xs text-ink-2" lang="en">{t(lang, 'case.lang-note')}</span>}
        {translation && <a class="link font-sans text-sm" href={caseUrl(translation.id, translation.data.lang)}>{t(lang, 'case.other-lang')}</a>}
      </div>
    </header>

    {
      d.status === 'in-progress' && d.pending.length > 0 && (
        <aside class="mt-10 max-w-[52rem] rounded-lg border border-rule p-5 md:p-6" aria-labelledby="pending-title">
          <h2 id="pending-title" class="font-sans text-sm font-semibold">{t(lang, 'case.pending')}</h2>
          <ul class="mt-3 space-y-1.5 font-sans text-sm text-ink-2">
            {d.pending.map((p) => (
              <li class="flex gap-2.5">
                <span class="mt-[0.55em] inline-block size-1.5 shrink-0 rounded-full border border-ink-2" aria-hidden="true" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <div class="mt-12 grid gap-12 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16">
      <aside class="order-2 lg:order-1">
        <div class="space-y-6 font-sans text-sm lg:sticky lg:top-24">
          <dl class="space-y-4">
            {
              d.context && (
                <div>
                  <dt class="font-semibold">{t(lang, 'case.context')}</dt>
                  <dd class="mt-1 text-ink-2">{d.context}</dd>
                </div>
              )
            }
            {
              d.data && (
                <div>
                  <dt class="font-semibold">{t(lang, 'case.data')}</dt>
                  <dd class="mt-1 text-ink-2">{d.data}</dd>
                </div>
              )
            }
            <div>
              <dt class="font-semibold">{t(lang, 'case.stack')}</dt>
              <dd class="mt-1 text-ink-2">{d.stack.join(', ')}</dd>
            </div>
            <div>
              <dt class="font-semibold">{t(lang, 'case.code')}</dt>
              <dd class="mt-1 text-ink-2">
                {d.repo.url && d.repo.visibility === 'public' ? (
                  <a class="link" href={d.repo.url}>{d.repo.url.replace('https://', '')}</a>
                ) : (
                  t(lang, 'case.code.private')
                )}
              </dd>
            </div>
            <div>
              <dt class="font-semibold">{t(lang, 'case.report')}</dt>
              <dd class="mt-1 text-ink-2">
                {d.reportUrl ? <a class="link" href={d.reportUrl}>{d.reportUrl.replace('https://', '')}</a> : t(lang, 'case.report.none')}
              </dd>
            </div>
          </dl>

          {
            d.facts.length > 0 && (
              <div>
                <h2 class="font-semibold">{t(lang, 'case.facts')}</h2>
                <dl class="mt-2 divide-y divide-rule border-y border-rule">
                  {d.facts.map((f) => (
                    <div class="flex flex-col py-2.5">
                      <dt class="order-2 mt-1 text-xs text-ink-2">{f.label}</dt>
                      <dd class="tabular order-1 font-serif text-xl leading-none text-ink">{f.value}</dd>
                      <dd class="order-3 mt-0.5 text-[0.7rem] leading-snug text-ink-2">{f.source}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )
          }

          <p class="text-xs leading-relaxed text-ink-2">
            {t(lang, 'case.verified')}{' '}
            {commitUrl ? <a class="link" href={commitUrl}>commit {d.verified.commit}</a> : <span>commit {d.verified.commit}</span>}, {date}.
          </p>

          {
            sections.length > 2 && (
              <nav aria-label={t(lang, 'case.contents')} class="no-print hidden lg:block">
                <h2 class="font-semibold">{t(lang, 'case.contents')}</h2>
                <ol class="mt-2 space-y-1 text-ink-2">
                  {sections.map((s) => (
                    <li>
                      <a class="hover:text-ink" href={`#${s.slug}`}>{s.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
        </div>
      </aside>

      <div class="prose-case order-1 lg:order-2 [counter-reset:case-section]">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
