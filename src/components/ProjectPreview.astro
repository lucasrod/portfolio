---
/**
 * Small, honest previews: a real data shape (Ames) or the real structure of the
 * code (pipeline / architecture). No invented numbers.
 */
import summary from '../data/ames-summary.json';

interface Props {
  kind: 'ames-histogram' | 'census-pipeline' | 'preddesk-layers' | 'faro-sources';
}
const { kind } = Astro.props;

// Ames: histogram of log10(sale price)
const h = summary.logPriceHistogram;
const maxCount = Math.max(...h.counts);
const lo = h.edgesLog10[0];
const hi = h.edgesLog10[h.edgesLog10.length - 1];
const W = 320, H = 180, padL = 12, padR = 12, padT = 18, padB = 34;
const xOf = (v: number) => padL + ((v - lo) / (hi - lo)) * (W - padL - padR);
const yOf = (c: number) => H - padB - (c / maxCount) * (H - padT - padB);
const ticks = [50000, 100000, 200000, 400000].filter((v) => Math.log10(v) > lo && Math.log10(v) < hi);
const median = Math.log10(summary.medianPrice);
const k = (v: number) => `$${Math.round(v / 1000)}k`;
---

<div class="aspect-[16/9] w-full overflow-hidden rounded-lg bg-panel text-ink-2" aria-hidden="true">
  {
    kind === 'ames-histogram' && (
      <svg viewBox={`0 0 ${W} ${H}`} class="size-full" preserveAspectRatio="xMidYMid meet">
        {h.counts.map((c: number, i: number) => {
          const x0 = xOf(h.edgesLog10[i]);
          const x1 = xOf(h.edgesLog10[i + 1]);
          return <rect x={x0 + 0.75} y={yOf(c)} width={Math.max(0, x1 - x0 - 1.5)} height={H - padB - yOf(c)} rx="1" fill="var(--seq-2)" />;
        })}
        <line x1={xOf(median)} x2={xOf(median)} y1={padT - 6} y2={H - padB} stroke="var(--ink)" stroke-width="1" stroke-dasharray="2 3" />
        <text x={xOf(median) + 5} y={padT} font-size="10" fill="var(--ink)" font-family="var(--font-sans)">
          median {k(summary.medianPrice)}
        </text>
        <line x1={padL} x2={W - padR} y1={H - padB} y2={H - padB} stroke="var(--rule)" />
        {ticks.map((v) => (
          <text x={xOf(Math.log10(v))} y={H - padB + 16} font-size="10" text-anchor="middle" fill="currentColor" font-family="var(--font-sans)">
            {k(v)}
          </text>
        ))}
        <text x={W - padR} y={H - 6} font-size="9.5" text-anchor="end" fill="currentColor" font-family="var(--font-sans)">
          sale price, log scale, n = {summary.n.toLocaleString('en-US')}
        </text>
      </svg>
    )
  }

  {
    kind === 'census-pipeline' && (
      <svg viewBox="0 0 320 180" class="size-full" font-family="var(--font-sans)" font-size="9.5">
        <defs>
          <marker id="arr-c" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0 0 8 4 0 8Z" fill="var(--ink-2)" />
          </marker>
        </defs>
        {[
          { x: 10, w: 62, t: ['INE Census', '2023 persons'] },
          { x: 84, w: 52, t: ['Parquet', 'Snappy'] },
          { x: 148, w: 70, t: ['Preprocess,', 'K-means feature'] },
        ].map((b) => (
          <g>
            <rect x={b.x} y="62" width={b.w} height="44" rx="5" fill="var(--paper)" stroke="var(--rule)" />
            <text x={b.x + b.w / 2} y="80" text-anchor="middle" fill="var(--ink)">{b.t[0]}</text>
            <text x={b.x + b.w / 2} y="93" text-anchor="middle" fill="currentColor">{b.t[1]}</text>
          </g>
        ))}
        <line x1="72" y1="84" x2="82" y2="84" stroke="var(--ink-2)" marker-end="url(#arr-c)" />
        <line x1="136" y1="84" x2="146" y2="84" stroke="var(--ink-2)" marker-end="url(#arr-c)" />
        <path d="M218 84 C226 84 226 52 234 52" fill="none" stroke="var(--ink-2)" marker-end="url(#arr-c)" />
        <path d="M218 84 C226 84 226 116 234 116" fill="none" stroke="var(--ink-2)" marker-end="url(#arr-c)" />
        <rect x="236" y="32" width="76" height="40" rx="5" fill="var(--seq-2)" />
        <text x="274" y="49" text-anchor="middle" fill="var(--paper)">Attendance</text>
        <text x="274" y="62" text-anchor="middle" fill="var(--paper)" opacity="0.85">logistic</text>
        <rect x="236" y="96" width="76" height="40" rx="5" fill="var(--seq-3)" />
        <text x="274" y="113" text-anchor="middle" fill="var(--paper)">Employment</text>
        <text x="274" y="126" text-anchor="middle" fill="var(--paper)" opacity="0.85">random forest</text>
        <text x="10" y="166" fill="currentColor">scikit-learn pipelines, Typer CLI, pytest</text>
      </svg>
    )
  }

  {
    kind === 'preddesk-layers' && (
      <svg viewBox="0 0 320 180" class="size-full" font-family="var(--font-sans)" font-size="10">
        <rect x="20" y="16" width="280" height="148" rx="8" fill="var(--paper)" stroke="var(--rule)" />
        <text x="32" y="33" fill="currentColor">Interface: FastAPI, CLI</text>
        <rect x="40" y="42" width="240" height="108" rx="7" fill="var(--panel)" stroke="var(--rule)" />
        <text x="52" y="59" fill="currentColor">Application: use cases</text>
        <rect x="60" y="68" width="200" height="70" rx="6" fill="var(--seq-2)" />
        <text x="72" y="86" fill="var(--paper)">Domain</text>
        <text x="72" y="102" fill="var(--paper)" opacity="0.9">base rates, Bayesian updater,</text>
        <text x="72" y="115" fill="var(--paper)" opacity="0.9">signals, paper broker,</text>
        <text x="72" y="128" fill="var(--paper)" opacity="0.9">backtester</text>
        <text x="300" y="176" text-anchor="end" fill="currentColor" font-size="9.5">dependencies point inward</text>
      </svg>
    )
  }

  {
    kind === 'faro-sources' && (
      <svg viewBox="0 0 320 180" class="size-full" font-family="var(--font-sans)" font-size="10">
        <defs>
          <marker id="arr-f" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0 0 8 4 0 8Z" fill="var(--ink-2)" />
          </marker>
        </defs>
        <rect x="14" y="40" width="70" height="30" rx="5" fill="var(--paper)" stroke="var(--rule)" />
        <text x="49" y="59" text-anchor="middle" fill="var(--ink)">EVA courses</text>
        <rect x="14" y="98" width="70" height="30" rx="5" fill="var(--paper)" stroke="var(--rule)" />
        <text x="49" y="117" text-anchor="middle" fill="var(--ink)">OpenFING video</text>
        <path d="M84 55 C100 55 100 84 114 84" fill="none" stroke="var(--ink-2)" marker-end="url(#arr-f)" />
        <path d="M84 113 C100 113 100 84 114 84" fill="none" stroke="var(--ink-2)" marker-end="url(#arr-f)" />
        <rect x="116" y="66" width="76" height="36" rx="5" fill="var(--paper)" stroke="var(--rule)" />
        <text x="154" y="82" text-anchor="middle" fill="var(--ink)">Python workers</text>
        <text x="154" y="94" text-anchor="middle" fill="currentColor">capture, PDF</text>
        <line x1="192" y1="84" x2="210" y2="84" stroke="var(--ink-2)" marker-end="url(#arr-f)" />
        <rect x="212" y="66" width="94" height="36" rx="5" fill="var(--seq-2)" />
        <text x="259" y="82" text-anchor="middle" fill="var(--paper)">Course reader</text>
        <text x="259" y="94" text-anchor="middle" fill="var(--paper)" opacity="0.85">Next.js, Supabase</text>
      </svg>
    )
  }
</div>
