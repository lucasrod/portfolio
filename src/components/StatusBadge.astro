---
import { t, type Lang } from '../i18n/ui';
interface Props { status: 'published' | 'in-progress'; lang?: Lang }
const { status, lang = 'en' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-sans text-xs font-medium',
    status === 'published' ? 'bg-accent/12 text-accent-ink' : 'border border-rule text-ink-2',
  ]}
>
  <span
    class:list={['inline-block size-1.5 rounded-full', status === 'published' ? 'bg-accent' : 'border border-ink-2']}
    aria-hidden="true"></span>
  {t(lang, `status.${status}`)}
</span>
